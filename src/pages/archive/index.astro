---
// The Archive: every edition there has been. It is set as a ledger, like the
// Bulletin: release editions, a year at a time; daily editions on a calendar, a
// month at a time; and the sections the stories fall under. The calendar opens
// on the newest month; a month is on it once it has its first edition.
import Masthead from '../../components/Masthead.astro';
import { SECTIONS } from '../../config';
import Layout from '../../layouts/Layout.astro';
import { WEEKDAYS, calendarMonths } from '../../lib/calendar';
import { printed } from '../../lib/release-edition';
import { BAR, getReleaseEditions } from '../../lib/release-store';
import { countLabel, getEditions } from '../../lib/stories';

const editions = await getEditions();
const all = editions.flatMap((e) => e.stories);
const sections = SECTIONS.map((s) => ({
  ...s,
  count: all.filter((story) => story.data.section === s.id).length,
})).filter((s) => s.count > 0);
// The release editions, which stand apart from the daily ones: one a release, and not of any one day.
const releases = getReleaseEditions().map((edition) => ({
  ...edition.release,
  features: printed(edition, BAR).reduce((sum, area) => sum + area.count, 0),
  // A release belongs to the year in its name: Winter '27 is of 2027, though it arrives the autumn before.
  year: edition.release.name.match(/['’](\d\d)\b/) ? `20${edition.release.name.match(/['’](\d\d)\b/)![1]}` : edition.builtAt.slice(0, 4),
}));
// A year to a group, newest first, as the release editions already are.
const years = [...new Set(releases.map((release) => release.year))].map((year) => ({ year, releases: releases.filter((release) => release.year === year) }));
// Editions are numbered from the first, so the newest carries the highest number.
const digits = Math.max(2, String(editions.length).length);
const numbered = editions.map((edition, index) => ({
  ...edition,
  no: String(editions.length - index).padStart(digits, '0'),
}));
// A month to a sheet of the calendar, newest first, made from the editions themselves.
const months = calendarMonths(numbered);
const dayOf = (day: string) => new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${day}T12:00:00Z`));
const holds = (edition: (typeof numbered)[number]) =>
  edition.stories.length > 0 ? countLabel(edition.stories.length, 'story', 'stories') : countLabel(edition.briefs.length, 'brief', 'briefs');
---

<Layout title="Archive">
  <Masthead>
    <h1 class="dateline__text">Archive</h1>
  </Masthead>
  <main id="stories" class="wrap">
    {
      editions.length === 0 && releases.length === 0 ? (
        <p class="prose">
          No editions yet. Run <code>npm run pipeline</code> to build the first one.
        </p>
      ) : (
        <div class="ledger past">
          <p class="page-sub past__sum">
            {releases.length > 0
              ? `${countLabel(editions.length, 'daily edition', 'daily editions')}, ${countLabel(all.length, 'story', 'stories')} and ${countLabel(releases.length, 'release edition', 'release editions')}`
              : `${countLabel(editions.length, 'edition', 'editions')} and ${countLabel(all.length, 'story', 'stories')}`}
          </p>
          {releases.length > 0 && (
            <section class="ledger__row" id="release-editions" aria-labelledby="releases-title">
              <h3 id="releases-title">Release editions</h3>
              <div>
                {years.map((group) => (
                  <details class="past__month">
                    <summary>
                      <h4>{group.year}</h4>
                      <span class="past__count">{countLabel(group.releases.length, 'edition', 'editions')}</span>
                    </summary>
                    <ul class="past__list">
                      {group.releases.map((release) => (
                        <li class="past__row past__row--plain">
                          <a href={`/releases/${release.slug}/`}>{release.name}</a>
                          <span class="past__count">{countLabel(release.features, 'feature', 'features')}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            </section>
          )}
          {months.length > 0 && (
            <section class="ledger__row" id="daily-editions" aria-labelledby="editions-title">
              <h3 id="editions-title">Daily editions</h3>
              <div class="cal" data-calendar>
                <p class="visually-hidden" aria-live="polite" data-calendar-said></p>
                {months.map((month, index) => (
                  <section class="cal__month" id={`month-${month.key}`} data-month={month.key} data-said={`${month.name}, ${countLabel(month.editions.length, 'edition', 'editions')}`} aria-labelledby={`month-${month.key}-title`}>
                    <header class="cal__head">
                      <button type="button" class="cal__step" data-step="1" aria-label="Older month" disabled={index === months.length - 1} hidden>
                        <span aria-hidden="true">‹</span>
                      </button>
                      <h4 id={`month-${month.key}-title`}>
                        {month.name}
                        <span class="cal__count">{countLabel(month.editions.length, 'edition', 'editions')}</span>
                      </h4>
                      <button type="button" class="cal__step" data-step="-1" aria-label="Newer month" disabled={index === 0} hidden>
                        <span aria-hidden="true">›</span>
                      </button>
                    </header>
                    <table class="cal__grid">
                      <thead>
                        <tr>
                          {WEEKDAYS.map(([short, full]) => (
                            <th scope="col">
                              <abbr title={full}>{short}</abbr>
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {month.weeks.map((week) => (
                          <tr>
                            {week.map((cell) => (
                              <td>
                                {cell?.edition ? (
                                  <a
                                    class="cal__day cal__day--edition"
                                    href={`/${cell.day}/`}
                                    aria-label={`${dayOf(cell.day)}: edition ${Number(cell.edition.no)}, ${holds(cell.edition)}`}
                                    title={`No. ${cell.edition.no} · ${holds(cell.edition)}`}
                                  >
                                    {cell.date}
                                  </a>
                                ) : cell ? (
                                  <span class="cal__day">{cell.date}</span>
                                ) : null}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </section>
                ))}
              </div>
            </section>
          )}
          {sections.length > 0 && (
            <section class="ledger__row" id="sections" aria-labelledby="sections-title">
              <h3 id="sections-title">Sections</h3>
              <ul class="browse__sections">
                {sections.map((s) => (
                  <li>
                    <a class="chip" href={`/section/${s.id}/`}>
                      {s.label} <span class="chip__count">{s.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )
    }
  </main>
</Layout>

<script>
  // Without this, every month is shown, one under the other. With it, one month
  // at a time, the newest first, stepped through with the arrows beside its name.
  const calendar = document.querySelector<HTMLElement>('[data-calendar]');
  const months = [...(calendar?.querySelectorAll<HTMLElement>('[data-month]') ?? [])];
  const said = calendar?.querySelector<HTMLElement>('[data-calendar-said]');
  if (calendar && months.length > 1) {
    const show = (index: number, focus?: string) => {
      months.forEach((month, i) => (month.hidden = i !== index));
      if (!focus) return;
      if (said) said.textContent = months[index].dataset.said ?? '';
      // Keep the reader on the arrow they pressed; at the end of the months, on the other one.
      const step = months[index].querySelector<HTMLButtonElement>(`[data-step="${focus}"]`);
      (step && !step.disabled ? step : months[index].querySelector<HTMLButtonElement>('[data-step]:not(:disabled)'))?.focus();
    };
    calendar.classList.add('cal--paged');
    for (const step of calendar.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      step.hidden = false;
      step.addEventListener('click', () => {
        const from = months.indexOf(step.closest<HTMLElement>('[data-month]')!);
        show(Math.min(months.length - 1, Math.max(0, from + Number(step.dataset.step))), step.dataset.step);
      });
    }
    // A link to a month (#month-2026-10) opens the calendar on it.
    const wanted = months.findIndex((month) => `#${month.id}` === location.hash);
    show(Math.max(0, wanted));
  }
</script>
