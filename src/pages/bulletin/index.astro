---
import NewTab from '../../components/NewTab.astro';
// The Bulletin: what the paper keeps apart from its stories. Release dates,
// notices printed whatever they score, the releases of the tools it follows,
// and posts from the community. It shows the picture as it stands, so it is one
// page and not one a day; each kind of item stays on it for a while.
import { render } from 'astro:content';
import Masthead from '../../components/Masthead.astro';
import Tabs from '../../components/Tabs.astro';
import { PAPER, SITE } from '../../config';
import Layout from '../../layouts/Layout.astro';
import { WINDOWS, type BulletinKind } from '../../lib/bulletin';
import { deadlinesFrom, dueWithin, grouped } from '../../lib/deadlines';
import { quoteLine } from '../../lib/quote';
import { getQuote } from '../../lib/quote-store';
import { openReleases } from '../../lib/releases';
import { getReleaseDates, getReleaseEditions } from '../../lib/release-store';
import { formatDay, getBulletin } from '../../lib/stories';

const { latest, items } = await getBulletin();
const of = (kind: BulletinKind) => items.filter((item) => item.data.kind === kind);
// A notice of a release update is written in three parts (pipeline/release-notices.ts): what the notes say,
// what to do, and where it is on the Deadlines page. Here what to do leads, and the notes' words open beneath
// it, so a run of updates can be read down the page. Any other alert is printed as it was written.
const notice = (body: string | undefined) => {
  const parts = (body ?? '').trim().split(/\n{2,}/);
  const link = parts.at(-1)?.match(/^\[([^\]]+)\]\((\/deadlines\/[^)]*)\)$/);
  if (!link) return undefined;
  const rest = parts.slice(0, -1);
  const at = rest.findIndex((part) => part.startsWith('**What to do:**'));
  return {
    says: rest.filter((_, i) => i !== at),
    action: at < 0 ? undefined : rest[at].replace('**What to do:**', '').trim(),
    link: { text: link[1], href: link[2] },
  };
};
const alerts = await Promise.all(of('alert').map(async (item) => ({ item, Content: (await render(item)).Content, notice: notice(item.body) })));
const tools = of('release');
const community = of('community');
const slug = (id: string) => id.split('/').pop()!;

const releases = getReleaseDates();
const today = new Date().toISOString().slice(0, 10);
const open = openReleases(releases, today);
// A release whose notes are out has an edition of its own, which its line leads to.
const editions = new Map(getReleaseEditions().map((edition) => [edition.release.name, `/releases/${edition.release.slug}/`]));
// What the release notes say falls due within the month, which the Deadlines page sets out.
const due = dueWithin(grouped(deadlinesFrom(getReleaseEditions()), releases, today), today, 30);
// The share price at the last close, when the paper prints one and has a fresh one.
const quote = SITE.shares ? getQuote() : undefined;
const shares = quote && quoteLine(quote, SITE.shares!.name);
// A section is shown when the paper reads that kind of thing, whether or not there is any just now.
const follows = {
  releases: Boolean(PAPER.releases),
  alerts: Boolean(PAPER.alerts),
  tools: PAPER.sources.some((source) => source.type === 'code') || tools.length > 0,
  community: PAPER.sources.some((source) => source.type === 'discussion') || community.length > 0,
};
---

<Layout title="Bulletin">
  <Masthead>
    <h1 class="dateline__text">Bulletin</h1>
  </Masthead>
  <Tabs current="bulletin" />
  <main id="main" class="wrap">
    <div class="ledger bulletin">
      {/* Dated so a check of the built site can compare it with the front page's edition: see pipeline/check-site.ts. */}
      <p class="ledger__note bulletin__asof">
        As of <time datetime={latest} data-bulletin-as-of data-newest-item={items[0]?.data.date}>{formatDay(latest)}</time>.
      </p>

      {
        follows.releases && (
          <section class="ledger__row" id="releases">
            <h2>Releases</h2>
            <div>
            {/* The lines depend on the day they are read, so they are worked out again in the browser. */}
            <div data-releases={JSON.stringify(releases)} data-editions={JSON.stringify(Object.fromEntries(editions))}>
              {open.map(({ release, rest }) => (
                <p class="bulletin__release">
                  <strong>{release.name}</strong>
                  {rest}
                  {editions.has(release.name) && (
                    <>
                      {' '}
                      <a href={editions.get(release.name)}>Release&nbsp;edition</a>
                    </>
                  )}
                </p>
              ))}
              {open.length === 0 && <p class="ledger__none">No release dates are known.</p>}
            </div>
            {due > 0 && (
              <p class="bulletin__release bulletin__due">
                <strong>{due === 1 ? '1 change falls' : `${due} changes fall`} due</strong> within 30 days. <a href="/deadlines/">See the Deadlines</a>
              </p>
            )}
            </div>
          </section>
        )
      }

      {
        quote && shares && (
          <section class="ledger__row" id="shares">
            <h2>Share price</h2>
            <div>
              <p class="quote">
                <span class="visually-hidden">{shares.says}</span>
                <span aria-hidden="true">
                  <b>{quote.symbol}</b> {shares.price}{' '}
                  <span class:list={['quote__move', shares.mark && (quote.change > 0 ? 'quote__move--up' : 'quote__move--down')]}>
                    {shares.mark} {shares.change}
                  </span>
                </span>
              </p>
              <p class="ledger__note" aria-hidden="true">{SITE.shares!.name}, at the close on {formatDay(quote.day, 'short')}.</p>
            </div>
          </section>
        )
      }

      {
        follows.alerts && (
          <section class="ledger__row" id="alerts">
            <h2>
              Alerts <span class="bulletin__window">Last {WINDOWS.alert} days</span>
            </h2>
            <div>
              {alerts.map(({ item, Content, notice }) => (
                <article class="bulletin__item" id={slug(item.id)}>
                  {item.data.flag && <p class="flag">{item.data.flag}</p>}
                  <h3>
                    <a href={item.data.url} target="_blank" rel="noopener">
                      {item.data.title}
                    <NewTab /></a>
                  </h3>
                  {item.data.facts && <p class="bulletin__facts">{item.data.facts}</p>}
                  {notice ? (
                    <div class="bulletin__text bulletin__notice">
                      {notice.action && (
                        <p>
                          <span class="deadlines__label">What to do</span> {notice.action}
                        </p>
                      )}
                      {notice.says.length > 0 &&
                        (notice.action ? (
                          <details>
                            <summary>What the notes say</summary>
                            {notice.says.map((part) => (
                              <p>{part}</p>
                            ))}
                          </details>
                        ) : (
                          notice.says.map((part) => <p>{part}</p>)
                        ))}
                      <p>
                        <a href={notice.link.href}>{notice.link.text}</a>
                      </p>
                    </div>
                  ) : (
                    <div class="bulletin__text">
                      <Content />
                    </div>
                  )}
                </article>
              ))}
              {alerts.length === 0 && <p class="ledger__none">No alerts in the last {WINDOWS.alert} days.</p>}
            </div>
          </section>
        )
      }

      {
        follows.tools && (
          <section class="ledger__row" id="tools">
            <h2>
              Tools <span class="bulletin__window">Last {WINDOWS.release} days</span>
            </h2>
            <div>
              {tools.map((item) => (
                <article class="bulletin__item" id={slug(item.id)}>
                  <h3>
                    <a href={item.data.url} target="_blank" rel="noopener">
                      {item.data.title}
                    <NewTab /></a>
                  </h3>
                  <p class="bulletin__text">{item.data.line}</p>
                  <p class="bulletin__facts">{formatDay(item.data.date, 'short')}</p>
                </article>
              ))}
              {tools.length === 0 && <p class="ledger__none">No releases in the last {WINDOWS.release} days.</p>}
            </div>
          </section>
        )
      }

      {
        follows.community && (
          <section class="ledger__row" id="community">
            <h2>
              Community <span class="bulletin__window">Last {WINDOWS.community} days</span>
            </h2>
            <div>
              {community.map((item) => (
                <article class="bulletin__item" id={slug(item.id)}>
                  <h3>
                    <a href={item.data.url} target="_blank" rel="noopener">
                      {item.data.title}
                    <NewTab /></a>
                  </h3>
                  <p class="bulletin__text">{item.data.line}</p>
                  <p class="bulletin__facts">
                    {item.data.source} · {formatDay(item.data.date, 'short')}
                  </p>
                </article>
              ))}
              {community.length === 0 && <p class="ledger__none">Nothing from the community in the last {WINDOWS.community} days.</p>}
            </div>
          </section>
        )
      }
    </div>
  </main>
</Layout>

<script>
  import { openReleases, readReleases } from '../../lib/releases';

  const box = document.querySelector<HTMLElement>('[data-releases]');
  if (box) {
    const now = new Date();
    // The reader's own day, not the day the page was built.
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    try {
      const editions: Record<string, string> = JSON.parse(box.dataset.editions ?? '{}');
      const open = openReleases(readReleases(JSON.parse(box.dataset.releases ?? '[]')), today);
      if (open.length > 0) {
        box.replaceChildren(
          ...open.map(({ release, rest }) => {
            const line = document.createElement('p');
            line.className = 'bulletin__release';
            const name = document.createElement('strong');
            name.textContent = release.name;
            line.append(name, rest);
            const edition = editions[release.name];
            if (edition) {
              const link = document.createElement('a');
              link.href = edition;
              link.textContent = 'Release\u00a0edition';
              line.append(' ', link);
            }
            return line;
          }),
        );
      }
    } catch {
      // The lines stay as they were built.
    }
  }
</script>
