---
import Layout from '../layouts/Layout.astro';
import { folio, MAX_BRIEFS } from '../lib/editions';
import { formatDay, getEditions, getSignals, storySlug, type Edition } from '../lib/stories';
import BriefList from './BriefList.astro';
import FilterBar from './FilterBar.astro';
import Masthead from './Masthead.astro';
import Tabs from './Tabs.astro';
import StoryGrid from './StoryGrid.astro';

interface Props {
  edition: Edition;
  older?: string;
  newer?: string;
  isLatest?: boolean;
}

const { edition, older, newer, isLatest = false } = Astro.props;
const { day, stories } = edition;
const briefs = edition.briefs.slice(0, MAX_BRIEFS);
// A day with only briefs points back to the last edition that had stories.
const editions = await getEditions();
const lastFull = stories.length > 0 ? undefined : editions.find((other) => other.day < day && other.stories.length > 0)?.day;
// For the masthead: what the edition holds, and its volume and number.
const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const holds = [stories.length && count(stories.length, 'story', 'stories'), briefs.length && count(briefs.length, 'brief', 'briefs')].filter(Boolean).join(' · ') || 'Nothing new';
const numbered = folio(day, editions.map((other) => other.day));
// The marks, for the list of the edition's headlines that opens a narrow page.
const signals = await getSignals();
const MARK = { must: 'Must-read', recommended: 'Recommended', other: undefined };
const steps = [
  { day: older, label: 'Older edition', path: 'M10 3 5 8l5 5' },
  { day: newer, label: 'Newer edition', path: 'm6 3 5 5-5 5' },
];
---

<Layout title={isLatest ? undefined : formatDay(day)} edition={day} image={stories.find((story) => story.data.figure_image)?.data.figure_image}>
  <Masthead edition={numbered && { holds, ...numbered, date: formatDay(day) }}>
    {
      steps.map((step, i) => {
        const icon = (
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={step.path} />
          </svg>
        );
        const control = step.day ? (
          <a class="dateline__step" href={`/${step.day}/`} aria-label={`${step.label}, ${formatDay(step.day)}`}>
            {icon}
          </a>
        ) : (
          <span class="dateline__step" aria-hidden="true">
            {icon}
          </span>
        );
        // The date sits between the two arrows.
        return i === 0 ? (
          <>
            {control}
            <h1 class="dateline__text">
              <span class="dateline__long">{formatDay(day)}</span>
              <span class="dateline__short">{formatDay(day, 'short')}</span>
            </h1>
          </>
        ) : (
          control
        );
      })
    }
  </Masthead>
  <Tabs current="news" />

  <main id="main" class="wrap">
    <FilterBar stories={[...stories, ...briefs]} marks={stories.length > 0} />
    {/* On a narrow page the stories run in one long column, so their headlines come first, each a way to its story. They follow the filters as the stories do. */}
    {
      stories.length > 1 && (
        <nav class="contents" aria-labelledby="contents-title">
          <h2 id="contents-title">In this edition</h2>
          <ol>
            {stories.map((story) => (
              <li data-card data-id={story.id} data-personas={story.data.personas.join(' ')} data-signal={signals.get(story.id) ?? 'other'}>
                <a href={`#${storySlug(story)}`}>{story.data.title}</a>
                {MARK[signals.get(story.id) ?? 'other'] && <span class="contents__mark">{MARK[signals.get(story.id) ?? 'other']}</span>}
              </li>
            ))}
            {briefs.length > 0 && (
              <li data-card data-id="in-brief" data-personas={[...new Set(briefs.flatMap((brief) => brief.data.personas))].join(' ')}>
                <a href="#in-brief">In brief</a>
                <span class="contents__mark contents__mark--count">{count(briefs.length, 'brief', 'briefs')}</span>
              </li>
            )}
          </ol>
        </nav>
      )
    }
    <StoryGrid stories={stories} tags={false}>
      <BriefList briefs={briefs} alone={stories.length === 0} lastFull={lastFull} />
    </StoryGrid>
    <div class="empty" data-empty hidden>
      <p>Nothing in this edition matches those filters.</p>
      <button type="button" class="link-button" data-filter-clear>Clear filters</button>
    </div>
  </main>
</Layout>
