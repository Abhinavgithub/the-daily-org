---
import { SITE } from '../config';
import { quoteLine } from '../lib/quote';
import { getQuote } from '../lib/quote-store';

interface Props {
  /** Pre-fills the search box on the search page. */
  query?: string;
  /**
   * On an edition: what it holds, for the box beside the nameplate, and its
   * volume and number, for the folio line under it. The share price then moves
   * from the bar above into the box on the other side, as a paper's ears.
   */
  edition?: { holds: string; volume: string; number: number; date: string };
}

const { query = '', edition } = Astro.props;
// The share price at the last close, when the paper prints one and has a fresh one.
const quote = SITE.shares ? getQuote() : undefined;
const shares = quote && quoteLine(quote, SITE.shares!.name);
// The name in three parts, when one word of it is printed in the paper's colour.
const at = SITE.accent ? SITE.name.indexOf(SITE.accent) : -1;
const name = at < 0 ? [SITE.name, '', ''] : [SITE.name.slice(0, at), SITE.accent, SITE.name.slice(at + SITE.accent!.length)];
---

<header class:list={['masthead', !edition && 'masthead--inner']}>
  <div class="masthead__bar">
    {/* The share price balances the theme button at the other end. On an edition it is in the ear beside the nameplate. */}
    {
      quote && shares && !edition && (
        <p class="quote" title={shares.says}>
          <span class="visually-hidden">{shares.says}</span>
          <span aria-hidden="true">
            <b>{quote.symbol}</b> {shares.price} <span class:list={['quote__move', shares.mark && (quote.change > 0 ? 'quote__move--up' : 'quote__move--down')]}>{shares.mark} {shares.change}</span>
          </span>
        </p>
      )
    }
    <form class="search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="site-search">Search all editions</label>
      <input
        id="site-search"
        type="search"
        name="q"
        value={query}
        placeholder="Search all editions"
        autocomplete="off"
        aria-keyshortcuts="/"
        data-site-search
      />
      <!-- The key that jumps here, shown where there is a keyboard and the box is empty. -->
      <kbd class="search__key" aria-hidden="true">/</kbd>
      <button type="submit" aria-label="Search" title="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
    </form>
    <div class="masthead__tools">
      <button type="button" class="tool" data-theme-toggle aria-label="Switch to dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
    </div>
  </div>
  <!-- The line above the nameplate: the edition date, or the page's title. -->
  <div class="dateline"><slot /></div>
  <div class:list={['masthead__plate', edition && 'masthead__plate--ears']}>
    {
      edition && (
        <p class="ear ear--left">
          <b>Today</b>
          {edition.holds}
        </p>
      )
    }
    <a class="masthead__name" href="/">{name[0]}{name[1] && <span class="masthead__accent">{name[1]}</span>}{name[2]}</a>
    {
      edition && quote && shares && (
        <p class="ear ear--right" title={shares.says}>
          <span class="visually-hidden">{shares.says}</span>
          <span aria-hidden="true">
            <b>{quote.symbol}</b>
            {shares.price} <span class:list={['quote__move', shares.mark && (quote.change > 0 ? 'quote__move--up' : 'quote__move--down')]}>{shares.mark} {shares.change}</span>
          </span>
        </p>
      )
    }
  </div>
  {
    edition ? (
      <div class="masthead__motto masthead__motto--folio">
        <p class="masthead__by">
          Curated by <a href={SITE.creator.url} target="_blank" rel="noopener">{SITE.creator.name}</a>
        </p>
        <p class="folio">
          <span>Vol. {edition.volume} · No. {edition.number}</span>
          <span class="folio__tagline">{SITE.tagline}</span>
          <span class="folio__date">{edition.date}</span>
          <!-- On a narrow page, where the ears are left out and the date is already above the nameplate. -->
          <span class="folio__holds">{edition.holds}</span>
        </p>
      </div>
    ) : (
      <div class="masthead__motto">
        <p class="masthead__tagline">{SITE.tagline}</p>
        <p class="masthead__by">
          Curated by <a href={SITE.creator.url} target="_blank" rel="noopener">{SITE.creator.name}</a>
        </p>
      </div>
    )
  }
</header>
