---
import { formatDay, type Brief } from '../lib/stories';

// The close calls: articles that fell one point short of a story, set as one
// boxed clipping among the stories. Each is a headline that opens the original
// and a sentence on why it is worth a look. On a day with no stories the box
// is the edition, and runs the full width.

interface Props {
  briefs: Brief[];
  /** The edition has no stories, so the briefs are all of it. */
  alone?: boolean;
  /** The most recent edition that has stories, to point to when this one has none. */
  lastFull?: string;
  /** Set as a rail down the side of the stories, the height of the page. */
  rail?: boolean;
}

const { briefs, alone = false, lastFull, rail = false } = Astro.props;
// Across the page, in columns: when the briefs are the edition, or stand under a lead with no other stories.
const across = !rail;
const personas = [...new Set(briefs.flatMap((brief) => brief.data.personas))];
---

{
  briefs.length > 0 && (
    <section
      class:list={['briefs', rail ? 'briefs--rail' : 'briefs--alone']}
      id="in-brief"
      aria-labelledby="briefs-title"
      data-card
      data-id="in-brief"
      data-personas={personas.join(' ')}
    >
      {/* The rail is as tall as the stories beside it; what it holds stays in view as they are read. */}
      <div class="briefs__hold">
      <h2 class="briefs__title" id="briefs-title">In brief</h2>
      {
        alone && (
          <p class="briefs__note">
            No full stories today.
            {lastFull && (
              <>
                {' '}
                <a href={`/${lastFull}/`}>Read the edition of {formatDay(lastFull)}</a>.
              </>
            )}
          </p>
        )
      }
      <!-- Alone, the briefs run in as many columns as there are, up to three. -->
      <ul style={across ? `--columns: ${Math.min(briefs.length, 3)}` : undefined}>
        {briefs.map((brief) => (
          <li data-brief data-id={brief.data.url} data-personas={brief.data.personas.join(' ')}>
            <h3>
              <a href={brief.data.url} target="_blank" rel="noopener">{brief.data.title}</a>
            </h3>
            <p>{brief.data.why_read}</p>
            <p class="briefs__source">{brief.data.source}</p>
          </li>
        ))}
      </ul>
      </div>
    </section>
  )
}
