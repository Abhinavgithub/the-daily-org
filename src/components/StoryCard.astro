---
import NewTab from './NewTab.astro';
import { render } from 'astro:content';
import { sectionLabel, SITE } from '../config';
import type { Span } from '../lib/layout';
import type { Signal } from '../lib/signal';
import { deck } from '../lib/editions';
import { formatAuthors, formatDay, storySlug, tagSlug, type Story } from '../lib/stories';
import StoryFigure from './StoryFigure.astro';
import Verdict from './Verdict.astro';

interface Props {
  story: Story;
  /** Columns the story occupies, out of three. */
  span: Span;
  /** The story's standing in its own edition. */
  signal: Signal;
  /** Show the edition date, for pages that mix editions. */
  showDay?: boolean;
  /** List the story's section and tags under it. Left off the front page, where they crowd it. */
  tags?: boolean;
  /** The edition's lead: its headline is set as a banner across the page. */
  banner?: boolean;
}

const { story, span, signal, showDay = false, tags = true, banner = false } = Astro.props;
const { data } = story;
const { Content } = await render(story);
const slug = storySlug(story);
const source = data.source_type === 'video' ? `${data.source}, video` : data.source;
// The line above the headline: the writer and the blog, or the blog alone when no writer is known.
const writer = formatAuthors(data.authors);
// The reason to read: its first sentence under the headline, and any more behind the "why read this" button.
const why = deck(data.why_read);
const figure = data.figure && data.figure.kind !== 'none' ? data.figure : undefined;
// The story's mark in its edition, printed above it so the reader need not filter to find it.
const mark = signal === 'must' ? 'Must-read' : signal === 'recommended' ? 'Recommended' : undefined;
---

<article
  class:list={['story', `story--w${span}`, banner && 'story--banner']}
  id={slug}
  data-card
  data-id={story.id}
  data-personas={data.personas.join(' ')}
  data-signal={signal}
>
  {/* The running head: the story's mark, and its section where the tags below do not already give it. */}
  {
    (mark || !tags) && (
      <p class="story__kicker">
        {mark && <span class:list={['flag', signal === 'recommended' && 'flag--quiet']}>{mark}</span>}
        {!tags && <a href={`/section/${data.section}/`}>{sectionLabel(data.section)}</a>}
      </p>
    )
  }
  <p class="story__byline">
    <span>{writer ? `By ${writer}` : source}{writer && <span class="story__source"> · {source}</span>}</span>
    {why.rest && (
    <span class="why" data-why>
      <button type="button" class="why__button" aria-label="Why read this" aria-describedby={`why-${slug}`}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25"></circle>
          <path d="M8 7.25v4"></path>
          <circle cx="8" cy="4.9" r="0.4" fill="currentColor"></circle>
        </svg>
      </button>
      <span class="why__pop" role="tooltip" id={`why-${slug}`}>{why.rest}</span>
    </span>
    )}
  </p>
  <h2 class="story__title">
    <a class="story__link" href={data.url} target="_blank" rel="noopener" data-original>{data.title}<NewTab /></a>
  </h2>
  <p class="story__deck">{why.deck}</p>
  {/* On a phone the small button by the byline is easy to miss, so the rest of the reason opens here instead, in words. */}
  {
    why.rest && (
      <details class="story__why">
        <summary>Why read this</summary>
        <p>{why.rest}</p>
      </details>
    )
  }
  {/* The diagram opens the text, so that while it is stacked it can stand in the first of the story's columns with the text running beside it. */}
  <div class="story__text">{figure && <StoryFigure figure={figure} />}<Content /></div>
  <!-- The way to the article, said in words: the headline goes there too, but does not look like a link. -->
  <p class="story__more">
    <a href={data.url} target="_blank" rel="noopener" data-original>
      {data.source_type === 'video' ? 'Watch the video at' : 'Read the original at'} {data.source}
      <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  </p>
  {
    data.corrections.map((correction) => (
      <p class="correction">
        <span class="correction__label">Correction</span>
        <time datetime={correction.date}>{formatDay(correction.date, 'short')}</time>: {correction.text}
      </p>
    ))
  }
  {
    data.also.length > 0 && (
      <p class="story__also">
        Also told by{' '}
        {data.also.map((other, i) => (
          <>
            {i > 0 && ', '}
            <a href={other.url} target="_blank" rel="noopener" title={other.title}>{other.source}<NewTab /></a>
          </>
        ))}
      </p>
    )
  }
  {
    showDay && (
      <p class="story__meta">
        <a href={`/${data.date}/`}>{formatDay(data.date, 'short')}</a>
      </p>
    )
  }
  {tags && (
  <ul class="story__tags" aria-label="Section and tags">
    <li><a href={`/section/${data.section}/`}>{sectionLabel(data.section).toLowerCase()}</a></li>
    {
      data.tags.map((tag) => (
        <li>
          <a href={`/tag/${tagSlug(tag)}/`}>{tag}</a>
        </li>
      ))
    }
  </ul>
  )}
  {SITE.readerFeedback && <Verdict story={story.id} />}
  <!-- Anything else printed at the foot of the story. -->
  <slot />
</article>
