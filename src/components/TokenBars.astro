---
import { formatNumber, share, type ModelTokens } from '../lib/stats';

// Tokens by model, set like the page's other lists: the name with its total and
// share, then a bar on one scale shared by all the models, divided into what
// the model read and what it wrote, with the two figures printed beneath.

interface Props {
  rows: ModelTokens[];
}

const { rows } = Astro.props;
const total = (row: ModelTokens) => row.input + row.output;
const all = rows.reduce((sum, row) => sum + total(row), 0);
const input = rows.reduce((sum, row) => sum + row.input, 0);
const most = Math.max(1, ...rows.map(total));
---

<div class="models">
  <ul class="key">
    <li>
      <span class="key__swatch mark--light" aria-hidden="true" />
      Read (input) <b>{formatNumber(input)}</b>
    </li>
    <li>
      <span class="key__swatch mark--main" aria-hidden="true" />
      Written (output) <b>{formatNumber(all - input)}</b>
    </li>
  </ul>
  <ul class="models__list">
    {
      rows.map((row) => (
        <li>
          <span class="models__name">{row.model}</span>
          <span class="models__total">{formatNumber(total(row))}</span>
          <span class="models__share">{share(total(row), all)}%</span>
          <span class="models__track" aria-hidden="true">
            <span class="models__bar" style={`width: ${Math.max(0.5, (total(row) / most) * 100)}%`}>
              {row.input > 0 && <span class="mark--light" style={`flex-grow: ${row.input}`} />}
              {row.output > 0 && <span class="mark--main" style={`flex-grow: ${row.output}`} />}
            </span>
          </span>
          <span class="models__parts">
            {formatNumber(row.input)} read · {formatNumber(row.output)} written
          </span>
        </li>
      ))
    }
  </ul>
</div>
