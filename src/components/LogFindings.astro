---
import { RULES, type Finding } from '../lib/insights';
import { runId } from '../lib/logs';

// What the records say, most pressing first. Each says what was found, and under it what to do.

interface Props {
  findings: Finding[];
}

const { findings } = Astro.props;
const WORD = { problem: 'Problem', watch: 'Watch', fine: 'Fine' };
// The day of the run a finding comes from, as a finding is dated.
const day = (iso: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(new Date(iso));
// What a link says, by where it goes, so it can be told where it leads.
const LINK: Record<string, string> = { '#articles': 'See the articles', '#sources': 'See the scorecard', '#runs': 'See the runs' };
const linkText = (finding: Finding) => finding.link ?? (finding.run ? `See the ${day(finding.run)} run` : LINK[finding.href ?? ''] ?? 'See it');
// A time said outright, for a reader without the script that turns it into "2 hours ago".
const clock = (iso: string) => `on ${new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(iso))}`;
---

<ul class="findings">
  {
    findings.map((finding) => (
      <li
        class:list={['finding', `finding--${finding.tone}`]}
        hidden={finding.hidden}
        data-at={finding.tone !== 'fine' ? finding.lastRunAt : undefined}
        data-stale-after={finding.tone !== 'fine' && finding.lastRunAt ? RULES.staleHours : undefined}
      >
        <span class="finding__tone">{WORD[finding.tone]}</span>
        <div class="finding__text">
          <p class="finding__says">
            {finding.tone === 'fine' && finding.lastRunAt ? (
              <>
                <span data-at={finding.lastRunAt} data-fresh-within={RULES.staleHours}>
                  The pipeline ran{' '}
                  <time datetime={finding.lastRunAt} data-ago>
                    {clock(finding.lastRunAt)}
                  </time>
                  .{' '}
                </span>
                {!finding.items && finding.says}
              </>
            ) : finding.lastRunAt ? (
              <>
                The pipeline last ran{' '}
                <time datetime={finding.lastRunAt} data-ago>
                  {clock(finding.lastRunAt)}
                </time>
                .
              </>
            ) : (
              <>
                {!finding.items && finding.says}
                {finding.run && !finding.undated && <span class="finding__when">{day(finding.run)}</span>}
              </>
            )}
          </p>
          {finding.items && (
            <ul class="finding__items">
              {finding.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {finding.action && (
            <p class="finding__action">
              {finding.action}
              {finding.href && (
                <>
                  {' '}
                  {finding.run ? (
                    <a href={`#${runId(finding.run)}`} data-run-link>
                      {linkText(finding)}
                    </a>
                  ) : (
                    <a href={finding.href}>{linkText(finding)}</a>
                  )}
                </>
              )}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ul>
