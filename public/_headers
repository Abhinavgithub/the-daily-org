# Every page: no other site may show the paper inside a frame, files are taken as the type they are served as,
# and a link out tells the other site only that the reader came from the paper. The rest of the Content Security
# Policy is in each page's <meta> tag (astro.config.mjs); frame-ancestors only works as a header.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Caching rules, for hosts that read a _headers file. Fonts never change, so browsers may keep them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Built scripts and styles carry a fingerprint in their names.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The Deadlines calendar: asked for again by calendar programs, so kept for an hour only.
/deadlines.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600

# A story's picture can be redrawn under the same name, so it is kept for a day.
/figures/*
  Cache-Control: public, max-age=86400
