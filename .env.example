# Copy to .env and fill in LLM_API_KEY. Get a free key at https://openrouter.ai/keys
LLM_API_KEY=

# Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Ordered list: the first is the primary model, the rest are fallbacks.
# Run `npm run models` to see what is free right now.
LLM_MODELS=openrouter/free

# The pipeline refuses models that cost money unless this is 1.
LLM_ALLOW_PAID=0

# Optional. The most one run may spend, in US dollars. The run stops cleanly
# when it is reached and the rest is left for the next run. It relies on the
# provider reporting what each call cost, which OpenRouter does.
LLM_MAX_COST_USD=

# Optional. The most tokens a model may spend thinking before each answer.
# A model that thinks is paid for it, and some think for thousands of tokens
# before a short reply. A limit makes a run quicker and cheaper, and may make
# the editor's judgement of a hard article less steady: check with
# `npm run replay` before keeping one. Empty leaves it to the model; 0 is no
# thinking at all.
LLM_REASONING_TOKENS=

# Optional. An image model that draws the diagram of each edition's top story
# as an illustration. Image models are paid per picture, so check the price
# first. Empty, the page draws the diagrams itself.
LLM_IMAGE_MODEL=

# OpenRouter's free tier allows 20 requests a minute and 50 a day
# (1000 a day once the account has bought $10 of credits).
LLM_MAX_CALLS=40
LLM_MIN_INTERVAL_MS=3500

# Optional. With a key, a YouTube source is read through the YouTube Data API,
# which is reliable; without one it is read from YouTube's RSS feed, which fails
# at random. Create a key at https://console.cloud.google.com/ (enable
# "YouTube Data API v3", then Credentials > Create credentials > API key, and
# restrict the key to that API). It is free and reads public data only.
YOUTUBE_API_KEY=

# Optional. What you mean to spend on models in a month, in US dollars. The
# Logs page compares the month's recorded cost with it and says when
# spending is on pace to pass it. It limits nothing by itself.
MONTHLY_BUDGET_USD=

# Stories below this interest score (1-10) are not published.
SCORE_THRESHOLD=6

# Optional. Takes the place of the paper's `address` in paper.config.ts for the
# RSS feed, sitemap and link previews, for example on a test deployment.
SITE_URL=

# Optional. Lets `npm run readership` save who read the paper, for the Stats
# page: a token that can only read analytics, and the account and site it is
# for. Without them, readership is not shown.
READERSHIP_API_TOKEN=
READERSHIP_ACCOUNT_ID=
READERSHIP_SITE_ID=
