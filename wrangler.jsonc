// For Cloudflare, where the site is deployed as a Worker serving static files.
// Cloudflare runs `npm run build` (set in the Worker's build settings), then
// `npx wrangler deploy` uploads `dist`. With this file in place Wrangler does
// not try to set the project up by itself.
{
  "name": "the-daily-org",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // An address with no page gets the paper's own not-found page.
    "not_found_handling": "404-page"
  }
}
